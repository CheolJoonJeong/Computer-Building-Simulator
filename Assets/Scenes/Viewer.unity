--- !u!114 &1288563486
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1288563485}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fb4b438a0fbf65d419c253af2708ab72, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  parts:
  - {fileID: 1070450723}
  - {fileID: 1674812887}
  - {fileID: 1853468995}
  - {fileID: 954014639}
  - {fileID: 702460823}
  - {fileID: 651525711}
  - {fileID: 176922410}
  - {fileID: 1864219655}
  buttons:
  - {fileID: 283618735}
  - {fileID: 1921695706}
  - {fileID: 1498688909}
  - {fileID: 941916839}
  - {fileID: 1710133301}
  - {fileID: 986261561}
  - {fileID: 1986247469}
  - {fileID: 260786676}
  descriptions:
  - "\uCEF4\uD4E8\uD130\uC758 \uC5F0\uC0B0\uC744 \uB2F4\uB2F9\uD558\uB294 \uD575\uC2EC
    \uC7A5\uCE58\uC785\uB2C8\uB2E4. \uBA54\uC778\uBCF4\uB4DC \uC18C\uCF13\uC5D0 \uC9C1\uC811
    \uC7A5\uCC29\uB418\uBA70, \uBCC4\uB3C4\uC758 \uCF00\uC774\uBE14 \uC5F0\uACB0\uC740
    \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC \uBC1C\uC5F4\uC774 \uD06C\uAE30
    \uB54C\uBB38\uC5D0 \uCFE8\uB7EC\uC758 \uD32C \uC804\uC6D0 \uCF00\uC774\uBE14\uC774
    \uBA54\uC778\uBCF4\uB4DC\uC758 CPU_FAN \uD540\uC5D0 \uC5F0\uACB0\uD590\uC5EC
    \uC0AC\uC6A9\uD558\uBA74 \uBC1C\uC5F4\uC744 \uC904\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD654\uBA74 \uCD9C\uB825\uACFC \uADF8\uB798\uD53D \uC5F0\uC0B0\uC744 \uB2F4\uB2F9\uD558\uB294
    \uC7A5\uCE58\uC785\uB2C8\uB2E4. \uBA54\uC778\uBCF4\uB4DC\uC758 PCIe \uC2AC\uB86F\uC5D0
    \uC7A5\uCC29\uB418\uBA70, \uACE0\uC131\uB2A5 \uBAA8\uB378\uC740 PSU\uB85C\uBD80\uD130
    PCIe 8\uD540 \uCF00\uC774\uBE14\uB85C \uBCF4\uC870 \uC804\uC6D0\uC744 \uACF5\uAE09\uBC1B\uC544\uC57C
    \uD569\uB2C8\uB2E4."
  - "\uBAA8\uB4E0 \uBD80\uD488\uC744 \uC5F0\uACB0\uD558\uB294 \uAE30\uD310\uC785\uB2C8\uB2E4.
    PSU\uB85C\uBD80\uD130 \uBA54\uC778 \uC804\uC6D0 \uCF00\uC774\uBE14(ATX 24\uD540)\uACFC
    \uBCF4\uC870 \uC804\uC6D0 \uCF00\uC774\uBE14(CPU 8\uD540)\uC744 \uACF5\uAE09\uBC1B\uACE0,
    \uCF00\uC774\uC2A4 \uC804\uBA74 \uD328\uB110\uC758 \uC804\uC6D0 \uBC84\uD2BC(PWRSW),
    \uB9AC\uC14B \uBC84\uD2BC(RESET), \uC804\uC6D0 LED(PLED), \uC800\uC7A5\uC7A5\uCE58
    LED(HDD_LED), \uC804\uBA74 USB 3.0(FrontUSB3) \uCF00\uC774\uBE14\uC774 \uBAA8\uB450
    \uC774\uACF3\uC5D0 \uC5F0\uACB0\uB429\uB2C8\uB2E4."
  - "CPU\uC758 \uC5F4\uC744 \uC2DD\uD600\uC8FC\uB294 \uC7A5\uCE58\uC785\uB2C8\uB2E4.
    \uBA54\uC778\uBCF4\uB4DC\uC758 CPU_FAN \uD540\uC5D0 \uD32C \uC804\uC6D0 \uCF00\uC774\uBE14\uC744
    \uC5F0\uACB0\uD574\uC57C \uC815\uC0C1\uC801\uC73C\uB85C \uC791\uB3D9\uD569\uB2C8\uB2E4."
  - "\uBAA8\uB4E0 \uBD80\uD488\uC744 \uC218\uB0A9\uD558\uB294 \uBCF8\uCCB4\uC785\uB2C8\uB2E4.
    \uC804\uBA74 \uD328\uB110\uC758 \uC804\uC6D0/\uB9AC\uC14B \uBC84\uD2BC, LED,
    USB \uD3EC\uD2B8\uC5D0\uC11C \uB098\uC624\uB294 \uCF00\uC774\uBE14\uB4E4(PWRSW,
    RESET, PLED, HDD_LED, FrontUSB3)\uC774 \uBA54\uC778\uBCF4\uB4DC\uB85C \uC5F0\uACB0\uB429\uB2C8\uB2E4."
  - "\uB370\uC774\uD130\uB97C \uC784\uC2DC\uB85C \uC800\uC7A5\uD574 \uBE60\uB978
    \uCC98\uB9AC\uB97C \uB3D5\uB294 \uBA54\uBAA8\uB9AC\uC785\uB2C8\uB2E4. \uBA54\uC778\uBCF4\uB4DC\uC758
    RAM \uC2AC\uB86F\uC5D0 \uC9C1\uC811 \uC7A5\uCC29\uB418\uBA70 \uBCC4\uB3C4\uC758
    \uCF00\uC774\uBE14 \uC5F0\uACB0\uC740 \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4.
    \uB3D9\uC77C \uADDC\uACA9\uC758 \uBAA8\uB4C8 2\uAC1C\uB97C \uAC19\uC740 \uC0C9
    \uC2AC\uB86F \uC30D\uC5D0 \uC7A5\uCC29\uD558\uBA74 \uB4C0\uC5BC \uCC44\uB110\uC774
    \uD65C\uC131\uD654\uB418\uC5B4 \uC2F1\uAE00 \uCC44\uB110 \uB300\uBE44 \uC57D
    2\uBC30\uC758 \uB300\uC5ED\uD3ED\uC744 \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uB370\uC774\uD130\uB97C \uC800\uC7A5\uD558\uB294 \uACE0\uC18D \uC800\uC7A5\uC7A5\uCE58\uC785\uB2C8\uB2E4.
    PSU\uC758 \uC804\uC6D0 \uCF00\uC774\uBE14\uACFC \uBA54\uC778\uBCF4\uB4DC\uB85C
    \uC5F0\uACB0\uB418\uB294 \uB370\uC774\uD130 \uCF00\uC774\uBE14\uC774 \uD544\uC694\uD569\uB2C8\uB2E4(\uBCF4\uB4DC
    \uC2AC\uB86F\uC5D0 \uC9C1\uACB0\uB418\uB294 M.2 \uD0C0\uC785\uC740 \uBCC4\uB3C4
    \uCF00\uC774\uBE14\uC774 \uD544\uC694 \uC5C6\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4)."
  - "\uBAA8\uB4E0 \uBD80\uD488\uC5D0 \uC804\uB825\uC744 \uACF5\uAE09\uD558\uB294
    \uC7A5\uCE58\uC785\uB2C8\uB2E4. \uBA54\uC778\uBCF4\uB4DC(ATX24Pin, CPU8Pin),
    GPU(PCIe8Pin) \uB4F1\uC73C\uB85C \uD5A5\uD558\uB294 \uC804\uC6D0 \uCF00\uC774\uBE14\uC774
    \uC774\uACF3\uC5D0\uC11C \uCD9C\uBC1C\uD569\uB2C8\uB2E4."
  partNameText: {fileID: 0}
  descriptionText: {fileID: 1328819289}
  pivot: {fileID: 932603485}
  normalColor: {r: 1, g: 1, b: 1, a: 1}
  selectedColor: {r: 0.39607847, g: 0.39607847, b: 0.39607847, a: 1}
